config PLC_PPI_CONNECT_RS485
    bool "RS485 (serial port)"
    select APP_USE_RS485
config PLC_PPI_CONNECT_NETWORK
    bool "Wired network port"
    select APP_USE_ETH
endchoice

config PLC_PPI_IPV4_ADDR
    string "PPi IPv4 address"
    default "192.168.1.10"
    depends on PLC_PPI_CONNECT_NETWORK

config PLC_PPI_TCP_PORT
    int "PPI TCP port"
    range 0 65535
    default 102
    depends on PLC_PPI_CONNECT_NETWORK

endif # PLC_PPI

