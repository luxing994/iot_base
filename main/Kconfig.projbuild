config PLC_LS_LOAD_CONNECT_RS485
    bool "RS485 (serial port)"
    select APP_USE_RS485
config PLC_LS_LOAD_CONNECT_NETWORK
    bool "Wired network port"
    select APP_USE_ETH
endchoice

config PLC_LS_LOAD_IPV4_ADDR
    string "LS IPv4 address"
    default "169.254.221.83"
    depends on PLC_LS_LOAD_CONNECT_NETWORK

config PLC_LS_LOAD_TCP_PORT
    int "LS TCP port"
    range 0 65535
    default 9600
    depends on PLC_LS_LOAD_CONNECT_NETWORK

endif # PLC_LS_LOAD

# ---------------- Siemens PPI ----------------
config PLC_PPI
    bool "Siemens PPI"
    default n

if PLC_PPI

choice PLC_PPI_DEVICE_TYPE
    prompt "PPI device type"
    default PLC_PPI_OTHER_DEVICE
config PLC_PPI_CONTROLLER_DEVICE
    bool "Controller PPI device"
config PLC_PPI_ELECTROLYSIS_DEVICE
    bool "Electrolysis PPI device"
config PLC_PPI_OTHER_DEVICE
    bool "Common PPI device"
endchoice

choice PLC_PPI_CONNECT_MODE
    prompt "PPI connect mode"
    default PLC_PPI_CONNECT_RS232
config PLC_PPI_CONNECT_RS232
    bool "RS232 (program port)"
