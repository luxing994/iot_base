menu "Device Identity"

    config IOT_DEVICE_ID
        string "Device ID (devId)"
        default "JXGS001"
        help
            Device ID used in online / heartbeat packets and as the default devId
            before the host sends any command. Must be unique for every gateway.

    config IOT_DEVICE_NUMBER
        string "Device number (devNumber)"
        default "IIIG_1.0"
        help
            devNumber field of data reports.

endmenu

menu "TCP Server IP Configuration"

    # 上位机地址（本机作为客户端连接）
    choice EXAMPLE_IP_MODE
        prompt "IP Version"
        default EXAMPLE_IPV4
        help
            Host can use either IPV4 or IPV6.

        config EXAMPLE_IPV4
            bool "IPV4"

        config EXAMPLE_IPV6
            bool "IPV6"
            select EXAMPLE_CONNECT_IPV6

    endchoice

    config EXAMPLE_IPV4_ADDR
        string "IPV4 Address"
        default "192.168.0.165"
        depends on EXAMPLE_IPV4
        help
            Host IPV4 address.

    config EXAMPLE_IPV6_ADDR
        string "IPV6 Address"
        default "FE80::30AD:E57B:C212:68AD"
        depends on EXAMPLE_IPV6
        help
            Host IPV6 address.

    config EXAMPLE_PORT
        int "Data report port"
        range 0 65535
        default 3333
        help
            Host port that receives data reports.

    config EXAMPLE_PORT1
        int "Online / heartbeat port"
        range 0 65535
        default 3333
        help
            Host port that receives online and heartbeat packets.

endmenu

menu "Server Mode Configuration"

    # 本机监听端口（IP 版本沿用上面的 EXAMPLE_IP_MODE，原来这里重复定义了 EXAMPLE_IPV4/IPV6）
    config SERVER_PORT
        int "Command port"
        range 0 65535
        default 3333
        help
            Local port that receives JSON commands from the host.

    config SERVER_PORT1
        int "File transfer port"
        range 0 65535
        default 3333
        help
            Local port that receives file packets from the host.

    config EXAMPLE_KEEPALIVE_IDLE
        int "TCP keep-alive idle time(s)"
        default 5
        help
            Keep-alive idle time. In idle time without receiving any data from peer, will send keep-alive probe packet

    config EXAMPLE_KEEPALIVE_INTERVAL
        int "TCP keep-alive interval time(s)"
        default 5
        help
            Keep-alive probe packet interval time.

    config EXAMPLE_KEEPALIVE_COUNT
        int "TCP keep-alive packet retry send counts"
        default 3
        help
            Keep-alive probe packet retry count.
endmenu

menu "Sensor Configuration"

config SENSOR_MAX6675
    bool "Enable MAX6675 thermocouple sensor"
    default n

if SENSOR_MAX6675

config MAX6675_CS_GPIO
    int "MAX6675 CS GPIO number"
    default 10
    range 0 48
    help
        GPIO pin connected to MAX6675 CS (chip select, active low).

config MAX6675_SCK_GPIO
    int "MAX6675 SCK GPIO number"
    default 12
    range 0 48
    help
        GPIO pin connected to MAX6675 SCK (clock).

config MAX6675_SO_GPIO
    int "MAX6675 SO GPIO number (MISO)"
    default 13
    range 0 48
    help
        GPIO pin connected to MAX6675 SO (serial output / MISO).

endif # SENSOR_MAX6675

endmenu

menu "PLC Communication Configuration"

menuconfig PLC_PROTOCOLS_ENABLED
    bool "Enable PLC protocols"
    default y

if PLC_PROTOCOLS_ENABLED

# ---------------- FX (Mitsubishi MC) ----------------
config PLC_FX
    bool "Mitsubishi FX (MC)"
    default n

if PLC_FX

choice PLC_FX_DEVICE_TYPE
    prompt "FX device type"
    default PLC_FX_OTHER_DEVICE
config PLC_FX_RY_LINE
    bool "RY line machine"
config PLC_FX_XF_CONTROLLER
    bool "XF controller"            
config PLC_FX_SN_CACLREFILMAC
    bool "SN cacl refilling machine"
config PLC_FX_OTHER_DEVICE
    bool "Common FX device"
endchoice

choice PLC_FX_CONNECT_MODE
    prompt "FX connect mode"
    default PLC_FX_CONNECT_RS485
config PLC_FX_CONNECT_RS232
    bool "RS232 (program port)"
    select APP_USE_RS232
config PLC_FX_CONNECT_RS485
    bool "RS485 (serial port)"
    select APP_USE_RS485
config PLC_FX_CONNECT_NETWORK
    bool "Wired network port"
    select APP_USE_ETH
endchoice

config PLC_FX_IPV4_ADDR
    string "FX IPv4 address"
    default "169.254.221.82"
    depends on PLC_FX_CONNECT_NETWORK

config PLC_FX_TCP_PORT
    int "FX TCP port"
    range 0 65535
    default 8765
    depends on PLC_FX_CONNECT_NETWORK

endif # PLC_FX


# ---------------- Omron HostLink ----------------
config PLC_HOSTLINK
    bool "Omron HostLink"
    default n

if PLC_HOSTLINK

choice PLC_HOSTLINK_DEVICE_TYPE
    prompt "HostLink device type"
    default PLC_HOSTLINK_OTHER_DEVICE
config PLC_HOSTLINK_SN_CACLREFILMAC
    bool "SN cacl refilling machine"
config PLC_HOSTLINK_OTHER_DEVICE
    bool "Common HostLink device"
endchoice

choice PLC_HOSTLINK_CONNECT_MODE
    prompt "HostLink connect mode"
    default PLC_HOSTLINK_CONNECT_RS232
config PLC_HOSTLINK_CONNECT_RS232
    bool "RS232 (program port)"
    select APP_USE_RS232
config PLC_HOSTLINK_CONNECT_RS485
    bool "RS485 (serial port)"
    select APP_USE_RS485
config PLC_HOSTLINK_CONNECT_NETWORK
    bool "Wired network port"
    select APP_USE_ETH
endchoice

config PLC_HOSTLINK_IPV4_ADDR
    string "HostLink IPv4 address"
    default "169.254.221.83"
    depends on PLC_HOSTLINK_CONNECT_NETWORK

config PLC_HOSTLINK_TCP_PORT
    int "HostLink TCP port"
    range 0 65535
    default 9600
    depends on PLC_HOSTLINK_CONNECT_NETWORK

endif # PLC_HOSTLINK

# ---------------- LS Plc ----------------
config PLC_LS_LOAD
    bool "LS Load protocol"
    default n

if PLC_LS_LOAD

choice PLC_LS_LOAD_DEVICE_TYPE
    prompt "LS device type"
    default PLC_LS_LOAD_OTHER_DEVICE
config PLC_LS_LOAD_OTHER_DEVICE
