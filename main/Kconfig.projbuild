# --------- 底层资源聚合（可选）：根据选择自动开启 UART/ETH 等 ----------
config APP_USE_RS232
    bool "Use RS232 driver (auto)"
    depends on APP_USE_RS232_VISIBLE   # 只有有来源时才显示
    default n
      
    config APP_USE_RS232_VISIBLE
    bool
    def_bool y if PLC_FX_CONNECT_RS232 || PLC_HOSTLINK_CONNECT_RS232 || \
                    PLC_LS_LOAD_CONNECT_RS232 || PLC_PPI_CONNECT_RS232 || \
                    PLC_MODBUS_CONNECT_RS232 || TESTER_76T_CONNECT_RS232 || \
                    TESTER_AINUO_CONNECT_RS232

config APP_USE_RS485
    bool "Use RS485 driver (auto)"
    depends on APP_USE_RS485_VISIBLE   # 只有有来源时才显示
    default n

config APP_USE_RS485_VISIBLE
    bool
    def_bool y if PLC_FX_CONNECT_RS485 || PLC_HOSTLINK_CONNECT_RS485 || \
                    PLC_LS_LOAD_CONNECT_RS485 || PLC_PPI_CONNECT_RS485 || \
                    PLC_MODBUS_CONNECT_RS485 || TESTER_76T_CONNECT_RS485 || \
                    TESTER_AINUO_CONNECT_RS485

config APP_USE_ETH
    bool "Use Ethernet (auto)"
    depends on APP_USE_ETH_VISIBLE   # 只有有来源时才显示
    default n

config APP_USE_ETH_VISIBLE
    bool
    def_bool y if PLC_FX_CONNECT_NETWORK || PLC_HOSTLINK_CONNECT_NETWORK || \
                    PLC_LS_LOAD_CONNECT_NETWORK || PLC_PPI_CONNECT_NETWORK || \
                    PLC_MODBUS_CONNECT_NETWORK || TESTER_76T_CONNECT_NETWORK || \
                    TESTER_AINUO_CONNECT_NETWORK

endif  # PLC_PROTOCOLS_ENABLED
endmenu

