# sdkconfig.rename - 本项目配置项改名记录
# ESP-IDF 构建时会自动把旧 sdkconfig 中的旧名称迁移为新名称，配置值不会丢失
# CONFIG_DEPRECATED_OPTION                CONFIG_NEW_OPTION

CONFIG_EXAMPLE_IP_MODE                    CONFIG_IOT_HOST_IP_MODE
CONFIG_EXAMPLE_IPV4                       CONFIG_IOT_HOST_IPV4
CONFIG_EXAMPLE_IPV6                       CONFIG_IOT_HOST_IPV6
CONFIG_EXAMPLE_IPV4_ADDR                  CONFIG_IOT_HOST_IPV4_ADDR
CONFIG_EXAMPLE_IPV6_ADDR                  CONFIG_IOT_HOST_IPV6_ADDR
CONFIG_EXAMPLE_PORT                       CONFIG_IOT_HOST_REPORT_PORT
CONFIG_EXAMPLE_PORT1                      CONFIG_IOT_HOST_LINK_PORT
CONFIG_IOT_OTA_PORT                       CONFIG_IOT_HOST_OTA_PORT
CONFIG_SERVER_PORT                        CONFIG_IOT_CMD_PORT
CONFIG_SERVER_PORT1                       CONFIG_IOT_FILE_PORT
CONFIG_EXAMPLE_KEEPALIVE_IDLE             CONFIG_IOT_KEEPALIVE_IDLE
CONFIG_EXAMPLE_KEEPALIVE_INTERVAL         CONFIG_IOT_KEEPALIVE_INTERVAL
CONFIG_EXAMPLE_KEEPALIVE_COUNT            CONFIG_IOT_KEEPALIVE_COUNT

# 联网改为本项目实现（不再使用 ESP-IDF 示例组件 protocol_examples_common）
CONFIG_EXAMPLE_WIFI_SSID                  CONFIG_IOT_WIFI_SSID
CONFIG_EXAMPLE_WIFI_PASSWORD              CONFIG_IOT_WIFI_PASSWORD
CONFIG_EXAMPLE_CONNECT_ETHERNET           CONFIG_IOT_ETH_W5500
CONFIG_EXAMPLE_ETH_SPI_HOST               CONFIG_IOT_ETH_SPI_HOST
CONFIG_EXAMPLE_ETH_SPI_SCLK_GPIO          CONFIG_IOT_ETH_SPI_SCLK_GPIO
CONFIG_EXAMPLE_ETH_SPI_MOSI_GPIO          CONFIG_IOT_ETH_SPI_MOSI_GPIO
CONFIG_EXAMPLE_ETH_SPI_MISO_GPIO          CONFIG_IOT_ETH_SPI_MISO_GPIO
CONFIG_EXAMPLE_ETH_SPI_CS_GPIO            CONFIG_IOT_ETH_SPI_CS_GPIO
CONFIG_EXAMPLE_ETH_SPI_INT_GPIO           CONFIG_IOT_ETH_SPI_INT_GPIO
CONFIG_EXAMPLE_ETH_PHY_RST_GPIO           CONFIG_IOT_ETH_RST_GPIO
CONFIG_EXAMPLE_ETH_SPI_CLOCK_MHZ          CONFIG_IOT_ETH_SPI_CLOCK_MHZ
